require 'fileutils'

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# Firebase - use static frameworks for better compatibility
$RNFirebaseAsStaticFramework = true
ENV['RCT_NEW_ARCH_ENABLED'] = '0'

platform :ios, min_ios_version_supported

# Do NOT enable global modular headers for React Native.
# Global use_modular_headers! caused:
# "Redefinition of module 'react_runtime'"
# use_modular_headers!

prepare_react_native_project!

require_relative '../node_modules/react-native-permissions/scripts/setup'
setup_permissions([
  'Camera',
  'LocationWhenInUse',
  'PhotoLibrary',
])

# Firebase Swift pods need frameworks so Swift-generated headers are available.
use_frameworks! :linkage => :static

# Firebase Swift static-framework dependencies need module maps.
# Use selective modular headers here instead of global use_modular_headers!.
pod 'FirebaseAuthInterop', :modular_headers => true
pod 'FirebaseAppCheckInterop', :modular_headers => true
pod 'FirebaseMessagingInterop', :modular_headers => true
pod 'FirebaseRemoteConfigInterop', :modular_headers => true
pod 'FirebaseSessions', :modular_headers => true
pod 'FirebaseCoreInternal', :modular_headers => true
pod 'FirebaseFirestoreInternal', :modular_headers => true
pod 'GoogleUtilities', :modular_headers => true
pod 'GoogleDataTransport', :modular_headers => true
pod 'nanopb', :modular_headers => true
pod 'RecaptchaInterop', :modular_headers => true

# Keep gRPC non-modular to avoid the previous gRPC module-map problems.
pod 'gRPC-C++', :modular_headers => false
pod 'gRPC-Core', :modular_headers => false

# Google Maps provider for react-native-maps.
# Required because AppDelegate.swift imports GoogleMaps.
rn_maps_path = '../node_modules/react-native-maps'
pod 'react-native-maps', :path => rn_maps_path, :subspecs => ['Google']

target 'RoadWorkTracker' do
  config = use_native_modules!

  # React Native 0.83 requires Hermes as the default engine.
  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :hermes_enabled => true,
    :new_arch_enabled => false
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
    )

    full_react_core_target = installer.pods_project.targets.find { |t| t.name =~ /^React-Core-[a-f0-9]+$/ }
    full_react_core_framework_dir = full_react_core_target ? "$(PODS_CONFIGURATION_BUILD_DIR)/#{full_react_core_target.name}" : nil

    # Fix script sandboxing problems in newer Xcode versions.
    installer.pods_project.build_configurations.each do |config|
      config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
      defs = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || ['$(inherited)']
      defs = [defs] unless defs.is_a?(Array)
      defs << 'RCT_ENABLE_INSPECTOR=0' unless defs.include?('RCT_ENABLE_INSPECTOR=0')
      defs << 'RCT_REMOTE_PROFILE=0' unless defs.include?('RCT_REMOTE_PROFILE=0')
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = defs
    end

    installer.aggregate_targets.each do |aggregate_target|
      aggregate_target.user_project.native_targets.each do |native_target|
        native_target.build_configurations.each do |config|
          config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
        end
      end
      aggregate_target.user_project.save
    end

    installer.pods_project.targets.each do |target|
      # Fix duplicate op-sqlite libsql headers copied into the generated framework.
      if target.name == 'op-sqlite'
        target.build_configurations.each do |config|
          config.build_settings['PRODUCT_NAME'] = 'op_sqlite'
          config.build_settings['PRODUCT_MODULE_NAME'] = 'op_sqlite'
        end

        if target.respond_to?(:product_reference) && target.product_reference
          target.product_reference.name = 'op_sqlite.framework'
          target.product_reference.path = 'op_sqlite.framework'
        end

        target.build_phases.each do |phase|
          next unless phase.respond_to?(:files)

          phase.files.to_a.each do |file|
            display_name = file.display_name.to_s
            path = file.file_ref&.path.to_s
            real_path = ''
            begin
              real_path = file.file_ref&.real_path.to_s
            rescue
              real_path = ''
            end

            combined = "#{display_name} #{path} #{real_path}"
            if combined.include?('libsql_experimental.xcframework') ||
               combined.include?('libsql.h') ||
               combined.include?('libsql-ffi.h') ||
               combined.include?('SQLite.framework')
              puts "Removing duplicate op-sqlite build phase file: #{combined}"
              file.remove_from_project
            end
          end
        end
      end

      target.build_configurations.each do |config|
        # Fix deployment target warnings.
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
        # Fix React Native / Firebase / Hermes script sandboxing.
        config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
        # Allow mixed modular/non-modular headers when static frameworks are enabled.
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'

        # Keep RN inspector/profile macros coherent for RN 0.83 pod targets.
        defs = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || ['$(inherited)']
        defs = [defs] unless defs.is_a?(Array)
        defs << 'RCT_ENABLE_INSPECTOR=0' unless defs.include?('RCT_ENABLE_INSPECTOR=0')
        defs << 'RCT_REMOTE_PROFILE=0' unless defs.include?('RCT_REMOTE_PROFILE=0')
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = defs

        # Ensure React-Core targets can find RN DevSupport headers when using static frameworks.
        if target.name.start_with?('React-Core')
          header_paths = config.build_settings['HEADER_SEARCH_PATHS'] || ['$(inherited)']
          header_paths = [header_paths] unless header_paths.is_a?(Array)
          header_paths << '$(PODS_ROOT)/Headers/Public/React' unless header_paths.include?('$(PODS_ROOT)/Headers/Public/React')
          header_paths << '$(PODS_TARGET_SRCROOT)/React/DevSupport' unless header_paths.include?('$(PODS_TARGET_SRCROOT)/React/DevSupport')
          header_paths << '$(PODS_TARGET_SRCROOT)/React/Base' unless header_paths.include?('$(PODS_TARGET_SRCROOT)/React/Base')
          config.build_settings['HEADER_SEARCH_PATHS'] = header_paths
        end

        if full_react_core_framework_dir
          framework_paths = config.build_settings['FRAMEWORK_SEARCH_PATHS'] || ['$(inherited)']
          framework_paths = [framework_paths] unless framework_paths.is_a?(Array)
          framework_paths << full_react_core_framework_dir unless framework_paths.include?(full_react_core_framework_dir)
          config.build_settings['FRAMEWORK_SEARCH_PATHS'] = framework_paths
        end

        if target.name == 'React-Core.common'
          config.build_settings['DEFINES_MODULE'] = 'NO'
          config.build_settings['PRODUCT_NAME'] = 'ReactCoreCommon'
          config.build_settings['PRODUCT_MODULE_NAME'] = 'ReactCoreCommon'
        end

        if target.name == 'React-Core.common-React-Core_privacy'
          config.build_settings['PRODUCT_NAME'] = 'ReactCoreCommon_privacy'
        end

        # Fix gRPC modular header issues.
        if ['gRPC-C++', 'gRPC-Core'].include? target.name
          config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
          config.build_settings['DEFINES_MODULE'] = 'NO'
        end
      end

      # Fix missing module map for gRPC-C++-dummy.
      if target.name == 'gRPC-C++'
        target.build_configurations.each do |config|
          config.build_settings['DEFINES_MODULE'] = 'NO'
          config.build_settings['MODULEMAP_FILE'] = ''
        end
      end

      if target.name == 'React-Core.common'
        target.source_build_phase.files.to_a.each(&:remove_from_project)
      end
    end

    # Targeted React-Core dedupe for RN + use_frameworks! archive collisions.
    duplicate_react_headers = %w[
      RCTDevLoadingViewProtocol.h
      RCTDevLoadingViewSetEnabled.h
      RCTInspectorDevServerHelper.h
      RCTInspectorNetworkHelper.h
      RCTInspectorUtils.h
      RCTPackagerClient.h
      RCTPackagerConnection.h
      RCTPausedInDebuggerOverlayController.h
    ]

    installer.pods_project.targets.each do |target|
      next unless target.name =~ /^React-Core-[a-f0-9]+$/

      target.build_phases.each do |phase|
        next unless phase.is_a?(Xcodeproj::Project::Object::PBXHeadersBuildPhase)

        files_by_name = Hash.new { |h, k| h[k] = [] }
        phase.files.to_a.each do |build_file|
          header_name = build_file.file_ref&.path.to_s
          files_by_name[header_name] << build_file
        end

        duplicate_react_headers.each do |header_name|
          files = files_by_name[header_name]
          next if files.length < 2

          files[1..].each do |build_file|
            puts "Deduplicating React-Core overlap header from #{target.name}: #{header_name}"
            build_file.remove_from_project
          end
        end
      end
    end

    # Manually create the missing module map file.
    grpc_dummy_path = "#{installer.sandbox.root}/Headers/Private/gRPC-C++-dummy"
    FileUtils.mkdir_p(grpc_dummy_path)
    module_map_content = <<~MAP
      framework module gRPC_C___dummy {
        umbrella header "PodsDummy_gRPC_C__.h"
        export *
        module * { export * }
      }
    MAP
    File.write("#{grpc_dummy_path}/module.modulemap", module_map_content)

    # Some pods (RNNotifee, RNFS) import DevSupport/Inspector headers as <React/...>.
    # Mirror DevSupport AND Inspector headers into Pods/Headers/Public/React so that
    # <React/RCTDevLoadingViewProtocol.h> and <React/RCTInspectorPackagerConnection.h> resolve.
    react_native_root = File.expand_path('../node_modules/react-native', __dir__)
    react_public_headers = "#{installer.sandbox.root}/Headers/Public/React"
    FileUtils.mkdir_p(react_public_headers)
    ['React/DevSupport'].each do |subdir|
      Dir.glob(File.join(react_native_root, subdir, '*.h')).each do |src|
        dst = File.join(react_public_headers, File.basename(src))
        FileUtils.cp(src, dst) unless File.exist?(dst)
      end
    end
  end
end
