{
  "name": "RoadWorkTracker",
  "version": "0.0.2",
  "private": true,
  "scripts": {
    "android": "react-native run-android --port 2468",
    "android:devices": "adb devices",
    "android:usb:reverse": "node scripts/adb-reverse-all.js",
    "android:usb": "node scripts/run-android-target.js usb",
    "android:emu": "node scripts/run-android-target.js emu",
    "android:qa": "react-native run-android --mode qa --port 2468",
    "ios": "react-native run-ios --port 2468",
    "ios:sim": "react-native run-ios --simulator \"iPhone 15\" --port 2468",
    "ios:device": "react-native run-ios --device --port 2468",
    "ios:debug:react-core": "bash ios/scripts/debug-react-core-common.sh /tmp/rw-dd-debugtools",
    "ios:debug:react-core:replay": "bash ios/scripts/replay-react-core-common-compile.sh /tmp/rw-dd-debugtools2",
    "ios:debug:react-core:extract": "bash ios/scripts/extract-react-core-failure.sh",
    "ios:debug:react-core:compare": "bash ios/scripts/compare-react-core-failures.sh",
    "lint": "eslint .",
    "start:metro": "npm run start",
    "start": "react-native start --host 0.0.0.0 --port 2468",
    "test": "jest",
    "postinstall": "node scripts/ensure-rnfirebase-tsconfig-base.js"
  },
  "dependencies": {
    "@notifee/react-native": "^9.1.8",
    "@op-engineering/op-sqlite": "^15.2.5",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-community/slider": "^5.1.2",
    "@react-native-firebase/app": "^23.8.6",
    "@react-native-firebase/auth": "^23.8.6",
    "@react-native-firebase/crashlytics": "^23.8.6",
    "@react-native-firebase/firestore": "^23.8.6",
    "@react-native-firebase/functions": "^23.8.6",
    "@react-native-firebase/storage": "^23.8.6",
    "@react-native/new-app-screen": "0.83.1",
    "@react-navigation/bottom-tabs": "^7.10.1",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.12.0",
    "@react-navigation/stack": "^7.6.16",
    "react": "19.2.0",
    "react-native": "0.83.1",
    "react-native-device-info": "^15.0.2",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-image-picker": "^8.2.1",
    "react-native-maps": "^1.26.20",
    "react-native-permissions": "^5.4.4",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "^4.24.0",
    "react-native-share": "^12.2.5",
    "react-native-svg": "^15.15.4",
    "react-native-toast-message": "^2.3.3",
    "react-native-vector-icons": "^10.3.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "^20.1.2",
    "@react-native-community/cli-platform-android": "^20.1.2",
    "@react-native-community/cli-platform-ios": "^20.0.0",
    "@react-native/babel-preset": "0.83.1",
    "@react-native/eslint-config": "0.83.1",
    "@react-native/metro-config": "0.83.1",
    "@react-native/typescript-config": "0.83.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^19.1.0",
    "@types/uuid": "^10.0.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
